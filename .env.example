# Copy this file to .env and fill in your values. NEVER commit .env.

# --- REQUIRED (pick one provider) ------------------------------------------

# Option A: OpenRouter (default). Free pool = 50 requests/day.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Option B: Groq (generous free tier, ~14k requests/day).
#   https://console.groq.com/keys
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: Google Gemini free tier (AI Studio key).
#   https://aistudio.google.com/apikey
# LLM_API_KEY=your-google-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Option D: Ollama on your own machine (no key, no internet).
#   ollama pull llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Optional model override (works with any provider above)
# LLM_MODEL=openrouter/free

# --- OPTIONAL ---------------------------------------------------------------
# Only needed if you use the admin-only POST /register endpoint
ADMIN_TOKEN=pick-any-secret-string

# How often (hours) the server re-crawls + re-embeds every registered site
# in the background ("the index re-trains itself"). 0 disables. Default 24.
# REFRESH_HOURS=24

# Chunks embedded per onnxruntime forward pass. MEMORY knob, not a speed one:
# the default fastembed batch (256) peaked at 778MB on a 178-chunk site and
# OOM-killed Render's free 512MB worker on every /ingest. 16 peaks at ~290MB.
# Raise only on a larger instance, and re-measure. Default 16.
# EMBED_BATCH=16
