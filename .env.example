# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is gitignored and is never copied into the Docker image --
# it is read at container start via docker-compose's env_file.

# ---- required ---------------------------------------------------------------
# Groq API key. The server refuses to boot without it (see compass/boot.py).
# Free key: https://console.groq.com
GROQ_API_KEY=

# Shared secret for the admin-only endpoints (/register, /ingest).
ADMIN_TOKEN=change-me

# ---- Django -----------------------------------------------------------------
# Signs cookies and tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Must be false in production: with it on, Django returns full stack traces
# (including settings values) in HTTP error responses.
DJANGO_DEBUG=false

# Comma-separated Host-header allowlist. "*" accepts any Host.
DJANGO_ALLOWED_HOSTS=*

# ---- optional ---------------------------------------------------------------
# Chat model used for answers. Default: openai/gpt-oss-120b
# COMPASS_LLM_MODEL=openai/gpt-oss-120b

# Where the ~90MB embedding model is cached. The Docker image bakes this in
# at build time, so you only need this when running outside Docker.
# FASTEMBED_CACHE=
